# Variáveis de Ambiente - Multi-Agent Framework

# API Keys
ANTHROPIC_API_KEY=your_api_key_here

# Configurações de Agentes
MAX_PARALLEL_AGENTS=12
AGENT_TIMEOUT_MINUTES=60
DEFAULT_MODEL=claude-sonnet-4-20250514
MAX_MODEL=claude-3-7-sonnet-20250219

# Git
MAIN_BRANCH=main
AUTO_COMMIT=true

# QA Pipeline
RUN_TESTS=true
RUN_LINTING=true
RUN_TYPE_CHECK=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Feature Flags
ENABLE_MEMORY_LAYER=true
ENABLE_AUTO_MERGE=false

# Backend
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=3000
NODE_ENV=development
